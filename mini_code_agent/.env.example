# 选择模型协议：mock（离线演示）、openai 或 anthropic。
MINI_AGENT_PROVIDER=openai

# 新会话会自动创建工作目录，例如 D:/agent_work/c-practice。留空时使用启动目录。
MINI_AGENT_WORKSPACE=

# 会话和日志的保存目录，启动时自动创建。相对路径从本文件所在目录算起。
MINI_AGENT_HOME=

# OpenAI 或兼容服务。在下方填写平台提供的模型名称、密钥和接口地址。
OPENAI_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1

# Anthropic 服务。使用该协议时填写此组参数。
ANTHROPIC_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://maas.qianwenaiapi.com/apps/anthropic
